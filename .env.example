# Copie para .env e preencha. O .env nunca vai para o git.

# Padrão: API NVIDIA (gratuita para desenvolvedores) -> https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-coloque-sua-chave-aqui

# Opcional: qualquer outra API compatível com OpenAI (OpenAI, OpenRouter, Groq, Ollama local...)
# SKILLER_API_BASE=https://api.openai.com/v1
# SKILLER_API_KEY=sk-...
# SKILLER_CHAT_MODEL=gpt-4.1-mini
# SKILLER_RERANK_MODEL=gpt-4.1-mini
# SKILLER_EMBED_MODEL=text-embedding-3-small
